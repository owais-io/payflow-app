# Copy to .env for local dev. Never commit .env.
# Load with: set -a; source .env; set +a
REDIS_URL=redis://localhost:6379/0
# Consumer name inside the group. Kubernetes and Docker set HOSTNAME to the pod/container
# name; in a shell it is usually not exported, so set it here.
HOSTNAME=notification-worker-local
METRICS_PORT=9100
LOG_LEVEL=INFO
