# docker compose settings for the local stack.
#   cp .env.example .env    then edit .env. Never commit .env.
# (services/*/.env.example are separate: for running one service with uvicorn outside Docker.)

# PostgreSQL: used by the postgres container and to build DATABASE_URL for both APIs.
# Local development only. Changing these after the database exists has no effect
# until its data is wiped.
POSTGRES_USER=payflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payflow

# Host port for the web page: http://localhost:${FRONTEND_PORT}
# (8080 is left free for Jenkins.)
FRONTEND_PORT=8081

# Python services' log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
